# Nabla environment variables
# Copy to .env and customize

# Postgres (REQUIRED — no insecure defaults)
POSTGRES_USER=nabla
POSTGRES_PASSWORD=          # Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# Letta Postgres connection (internal Docker network)
# Derived automatically from POSTGRES_USER/PASSWORD if not set
# LETTA_PG_URI=postgresql://nabla:CHANGEME@postgres:5432/letta

# Model configuration (Ollama on host)
NABLA_LLM_MODEL=ollama/gemma4:12b-q4:12b-q4
NABLA_EMBEDDING_MODEL=ollama/embeddinggemma:latest

# SECURITY NOTE: The Letta server (port 8284) has no API authentication.
# It is bound to 127.0.0.1 (localhost only) to prevent remote access.
# On multi-user hosts, restrict further with firewall rules:
#   sudo ufw deny 8284
#   sudo ufw allow from 127.0.0.1 to any port 8284
# Or use iptables:
#   sudo iptables -A INPUT -p tcp --dport 8284 -s 127.0.0.1 -j ACCEPT
#   sudo iptables -A INPUT -p tcp --dport 8284 -j DROP
