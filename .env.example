# Nabla operator configuration
# Copy to .env and customize. This file documents the OPERATOR set —
# the settings a deployment actually touches. Detection internals
# (exfil sigmas, passage/agent limits, connector paths) remain
# Settings-only by reviewed decision: see scripts/check_settings_plumbing.py,
# which enforces that every Settings field reaches the container and that
# this file equals the operator set exactly.

# Postgres (REQUIRED — no insecure defaults)
POSTGRES_USER=nabla
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Letta Postgres connection (internal Docker network)
# Derived automatically from POSTGRES_USER/PASSWORD if not set
# LETTA_PG_URI=postgresql://nabla:CHANGEME@postgres:5432/letta

# ── Models + Ollama tuning ─────────────────────────────────────
# LLM provider prefix selects the backend (ollama/…, openai/…).
NABLA_LLM_MODEL=ollama/gemma4:26b
# Embedding model tag must match what the endpoint serves (bare tag for Ollama).
NABLA_EMBEDDING_MODEL=embeddinggemma:latest
# OpenAI-compatible embedding endpoint (Ollama on the host by default).
NABLA_EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1
NABLA_OLLAMA_KEEP_ALIVE=24h
NABLA_OLLAMA_CONTEXT_LENGTH=32768
NABLA_OLLAMA_FLASH_ATTENTION=true
NABLA_OLLAMA_MAX_LOADED_MODELS=2
NABLA_LETTA_MAX_CONTEXT_WINDOW=32768
# Optional smaller model for Letta's own compaction summaries.
NABLA_LETTA_COMPACTION_MODEL=

# ── Setup + auth ───────────────────────────────────────────────
# One-time registration token for the web UI (generate like POSTGRES_PASSWORD).
NABLA_SETUP_TOKEN=
# DEV MODE: disables auth checks. NEVER enable in production.
NABLA_DEV_MODE=false
NABLA_JWT_EXPIRE_MINUTES=10080
NABLA_WEB_HOST=0.0.0.0
NABLA_WEB_PORT=8000

# ── Baselining behavior ─────────────────────────────────────────
NABLA_BASELINE_DAYS=21
# Complete-hour observations before entity baselines are trusted.
NABLA_ENTITY_WARMUP_OBSERVATIONS=3
# New accounts are exempt from z-score/spike detection for this many days.
NABLA_NEW_ACCOUNT_GRACE_DAYS=30

# ── Site identity ──────────────────────────────────────────────
# Site timezone for hour-based detectors (IANA name).
NABLA_TIMEZONE=UTC
# Audit-trail identity recorded on operator-triggered runs.
NABLA_OPERATOR=

# ── Account classification ──────────────────────────────────────
# Extra machine accounts (comma-separated): excluded from behavioral
# baselining, off-hours detection, and peer groups. Known trade-off:
# interactive use of a service account is a real attacker pattern —
# see the detector reference's blind-spot note.
NABLA_MACHINE_ACCOUNTS=
# Human overrides (comma-separated): force accounts back INTO baselining.
# The escape hatch for classification false positives.
NABLA_HUMAN_ACCOUNTS=

# ── Exfiltration allowlist ──────────────────────────────────────
# Sanctioned cloud services, comma-separated domain suffixes
# (tenant-level entries preferred: contoso.sharepoint.com, not sharepoint.com).
NABLA_SANCTIONED_SERVICES=

# ── Scheduled ingestion ────────────────────────────────────────
# 0 = off (the Dockerfile CMD switches on NABLA_WEB_ENABLED /
# NABLA_SCHEDULE_ENABLED container flags instead).
NABLA_SCHEDULE_ENABLED=false
NABLA_SCHEDULE_INTERVAL_MINUTES=5
NABLA_SCHEDULE_LOG_TYPES=all
NABLA_SCHEDULE_LOG_COUNT=50

# ── Risk tuning (what the UI displays) ──────────────────────────
NABLA_RISK_SCORE_DECAY_HALF_LIFE_HOURS=24.0
NABLA_RISK_SCORE_INVESTIGATION_CUTOFF=50.0

# ── Splunk (optional SIEM source) ───────────────────────────────
NABLA_SPLUNK_HOST=
NABLA_SPLUNK_TOKEN=
NABLA_SPLUNK_USERNAME=
NABLA_SPLUNK_PASSWORD=
NABLA_SPLUNK_AUTH_QUERY=
NABLA_SPLUNK_NETWORK_QUERY=
NABLA_SPLUNK_DNS_QUERY=
NABLA_SPLUNK_ENDPOINT_QUERY=

# ── SumoLogic (optional SIEM source) ────────────────────────────
NABLA_SUMOLOGIC_HOST=
NABLA_SUMOLOGIC_ACCESS_ID=
NABLA_SUMOLOGIC_ACCESS_KEY=
NABLA_SUMOLOGIC_AUTH_QUERY=
NABLA_SUMOLOGIC_NETWORK_QUERY=
NABLA_SUMOLOGIC_DNS_QUERY=
NABLA_SUMOLOGIC_ENDPOINT_QUERY=

# SECURITY NOTE: The Letta server (port 8284) has no API authentication.
# It is bound to 127.0.0.1 (localhost only) to prevent remote access.
# On multi-user hosts, restrict further with firewall rules:
#   sudo ufw deny 8284
#   sudo ufw allow from 127.0.0.1 to any port 8284
# Or use iptables:
#   sudo iptables -A INPUT -p tcp --dport 8284 -s 127.0.0.1 -j ACCEPT
#   sudo iptables -A INPUT -p tcp --dport 8284 -j DROP
