# ── Core ────────────────────────────────────────────────────────────────
# Letta API endpoint — override only; the compose default (http://letta:8283)
# is correct for the stack. Note the app reads NABLA_LETTA_BASE_URL.
# NABLA_LETTA_BASE_URL=http://letta:8283
# Postgres password (REQUIRED — compose refuses to boot without it).
# Compose builds the Letta connection URI from this + POSTGRES_USER — do not
# set LETTA_PG_URI separately unless overriding.
POSTGRES_PASSWORD=CHANGE_ME

# ── Operator access ─────────────────────────────────────────────────────
# If set, all /api/* endpoints require this token. Empty = login/registration
# flow (first registered user becomes the operator). Registration is rate-
# limited to 3/minute — watch typos on the first attempt.
NABLA_SETUP_TOKEN=
# Allow open access when no token is set (LOCAL DEV ONLY — keep false)
NABLA_DEV_MODE=false

# ── Models (Ollama) ─────────────────────────────────────────────────────
# Pull these on your Ollama host first: `ollama pull gemma4:latest`
NABLA_LLM_MODEL=ollama/gemma4:latest
NABLA_EMBEDDING_MODEL=embeddinggemma:latest
# Embedding endpoint must be reachable from INSIDE the letta container
NABLA_EMBEDDING_ENDPOINT=http://host.docker.internal:11434/v1

# ── Behavioral baseline tuning (defaults fine for evaluation) ───────────
# Days of real SIEM ingestion before entity detectors activate; 0 to skip
NABLA_BASELINE_DAYS=21
# Min pipeline runs before an entity has warm baselines
NABLA_ENTITY_WARMUP_OBSERVATIONS=3

# ── SIEM connectors (OPTIONAL — only for live ingestion) ────────────────
# Nabla runs fully on file/synthetic sources without these. If connecting
# your own SumoLogic, fill host + credentials; queries define per-log-type
# searches in SumoLogic query syntax.
NABLA_SUMOLOGIC_HOST=
NABLA_SUMOLOGIC_ACCESS_ID=
NABLA_SUMOLOGIC_ACCESS_KEY=
# Preferred: credentials in a 0600 file instead of env
# NABLA_SUMOLOGIC_CREDENTIALS_PATH=/run/secrets/sumo
NABLA_SUMOLOGIC_AUTH_QUERY=
NABLA_SUMOLOGIC_ENDPOINT_QUERY=

# ── Splunk (OPTIONAL — same pattern) ────────────────────────────────────
NABLA_SPLUNK_HOST=
NABLA_SPLUNK_TOKEN=
NABLA_SPLUNK_NETWORK_QUERY=
NABLA_SPLUNK_DNS_QUERY=
NABLA_SPLUNK_AUTH_QUERY=
NABLA_SPLUNK_ENDPOINT_QUERY=
